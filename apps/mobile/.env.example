# Copy to .env.local (git-ignored). EXPO_PUBLIC_* vars are inlined into the
# bundle at build time by Expo's own tooling — no extra config needed.

# Same Firebase web-app config as apps/web/.env.example — Firebase Console →
# Project Settings → General → Your apps → add a Web app (yes, even for the
# mobile app: this project uses the JS SDK, not @react-native-firebase).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# The deployed apps/web instance — /api/enrich, /api/unfurl, etc. live there.
# Local dev: point this at the machine running `npm run dev`, e.g.
# http://192.168.1.23:3000 (a physical device can't reach "localhost").
EXPO_PUBLIC_API_URL=
