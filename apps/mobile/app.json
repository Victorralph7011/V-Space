{
  "expo": {
    "name": "V-Space",
    "slug": "vspace",
    "scheme": "vspace",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icon.png",
    "splash": {
      "backgroundColor": "#08080A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.vspace.app"
    },
    "android": {
      "package": "space.vspace.app",
      "adaptiveIcon": {
        "backgroundColor": "#08080A"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./src/assets/icon.png",
          "color": "#08080A"
        }
      ]
    ]
  }
}
